# Base URL of the Laravel API.
# The default "/api" is proxied to http://localhost:8000 by the Vite dev server.
# Point this to your own backend when you deploy, e.g.
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=/api
VITE_DEMO_EMAIL=your-demo-email
VITE_DEMO_PASSWORD=your-demo-password
